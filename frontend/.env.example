# Public configuration for the MANDATE frontend. Nothing secret belongs here:
# every NEXT_PUBLIC_* value is shipped to the browser. There are no private
# keys, seed phrases or API secrets anywhere in this application.

# development | test | staging | production
NEXT_PUBLIC_APP_ENV=development

# The GenLayer network MANDATE is deployed to, and its chain id.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_CHAIN=61999

# Optional. Defaults to genlayer-js's StudioNet RPC (https://studio.genlayer.com/api).
NEXT_PUBLIC_GENLAYER_RPC_URL=

# The deployment of record (docs/deployment.json), byte-verified with scripts/inspect.py.
NEXT_PUBLIC_MANDATE_CONTRACT=0x5344bEae1A09c674831B174eD6BD077a5d7e58ba
