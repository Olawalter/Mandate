# Contract tests and scripts. No keys are needed anywhere in this repository:
# live tests and scripts create throwaway accounts funded from the StudioNet faucet.

# Set to 0 to run tests/integration against GenLayer StudioNet.
SKIP_INTEGRATION=1

# Reuse an existing deployment in the live suite instead of deploying the working tree.
MANDATE_CONTRACT=

# The material-change arc edits demo/northwind-compute/acceptable-use.md with real git
# commits and pushes them; it needs push access to the repository. Set to 0 to skip it.
MANDATE_DEMO_PUSH=1

# The frontend reads its own public configuration from frontend/.env.local
# (see frontend/.env.example).
